rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isHost(code) { return get(/databases/$(database)/documents/games/$(code)).data.host == request.auth.uid; }

    // 日本時間の今日(YYYY-MM-DD)
    function jstDate() {
      let t = request.time + duration.value(9, 'h');
      return string(t.year()) + '-' + (t.month() < 10 ? '0' : '') + string(t.month()) + '-' + (t.day() < 10 ? '0' : '') + string(t.day());
    }
    // XPからランクを求める
    function lvOf(x) {
      return x >= 14000 ? 15 : x >= 11000 ? 14 : x >= 8500 ? 13 : x >= 6500 ? 12 : x >= 4900 ? 11 : x >= 3600 ? 10
           : x >= 2600 ? 9 : x >= 1800 ? 8 : x >= 1200 ? 7 : x >= 800 ? 6 : x >= 500 ? 5 : x >= 300 ? 4 : x >= 150 ? 3 : x >= 50 ? 2 : 1;
    }
    function dayNo() { return math.floor((request.time.toMillis() + 32400000) / 86400000); }
    function weekNo() { return math.floor((dayNo() + 3) / 7); }
    function gMisD(o, n) { return n.get('mdd', 0) != o.get('mdd', 0); }
    function gMisW(o, n) { return n.get('mwk', 0) != o.get('mwk', 0); }
    function gMisOk(o, n) {
      return n.get('mdd', 0) is int && n.get('mwk', 0) is int
          && (n.get('mdd', 0) == o.get('mdd', 0) || (n.get('mdd', 0) == dayNo() && o.get('mdd', 0) < dayNo()))
          && (n.get('mwk', 0) == o.get('mwk', 0) || (n.get('mwk', 0) == weekNo() && o.get('mwk', 0) < weekNo()));
    }
    function gEvSame(o, n) { return n.get('evs', []).size() == o.get('evs', []).size(); }
    // 称号ごほうび: 受け取りずみの称号の記録(tt)。量はここで決める(アプリ側の表と同じ)
    function gTtSame(o, n) { return n.get('tt', []).size() == o.get('tt', []).size(); }
    // ステージのごほうび: 受け取りずみ(sg)。キーは「ステージ番号_星の数」と、全制覇の'all'
    function gSgSame(o, n) { return n.get('sg', []).size() == o.get('sg', []).size(); }
    function sTix(id) { return {'4_1': 1, '4_3': 1, '9_1': 1, '9_3': 1, '14_1': 2, '14_3': 1, '19_1': 3, '19_3': 1, 'all': 3}.get(id, 0); }
    function sShard(id) { return {'0_2': 3, '0_3': 5, '1_2': 3, '1_3': 5, '2_2': 3, '2_3': 6, '3_2': 3, '3_3': 6, '4_2': 4, '4_3': 7, '5_2': 4, '5_3': 7, '6_2': 4, '6_3': 8, '7_2': 4, '7_3': 8, '8_2': 5, '8_3': 9, '9_2': 5, '9_3': 9, '10_2': 5, '10_3': 10, '11_2': 5, '11_3': 10, '12_2': 6, '12_3': 11, '13_2': 6, '13_3': 11, '14_2': 6, '14_3': 12, '15_2': 6, '15_3': 12, '16_2': 7, '16_3': 13, '17_2': 7, '17_3': 13, '18_2': 7, '18_3': 14, '19_2': 7, '19_3': 14, 'all': 50}.get(id, 0); }
    function tTix(id) { return {'p30': 1, 'p100': 2, 'hi1': 1, 'hi10': 2, 'ace1': 2, 'gh1': 1, 'gh10': 2, 'd10': 1, 'ds3': 1, 'ds7': 2, 'ds30': 3, 'w1': 1, 'w5': 2, 'on4': 1, 'f3': 1, 'f5': 2, 'a50': 1, 'a100': 2, 'aall': 3, 'g10': 1, 'glr': 1, 'lv5': 1, 'lv10': 2, 'lv15': 3, 'st5': 1, 'st20': 2, 'sa60': 3, 'p300': 2, 'a150': 2, 'g30': 2, 'f10': 2, 'lv12': 2, 'x1': 3, 'x2': 3, 'x3': 2, 'x4': 1}.get(id, 0); }
    function tShard(id) { return {'p10': 5, 'p100': 20, 'hi10': 20, 'ace1': 30, 'gh10': 20, 'ds7': 20, 'ds30': 50, 'w1': 10, 'w5': 20, 'a10': 5, 'a50': 10, 'a100': 30, 'aall': 50, 'g10': 10, 'glr': 30, 'lv15': 50, 'st20': 10, 'sa60': 20, 'p300': 10, 'a150': 10, 'g30': 10}.get(id, 0); }
    function gEvOk(id) {
      let e = get(/databases/$(database)/documents/events/$(id)).data;
      return e.start <= jstDate() && jstDate() <= e.end;
    }
    function gDayGain(o, n) { return (n.day == jstDate() && o.day != n.day) ? 1 : 0; }
    function gLvGain(o, n) {
      return (n.lvg > o.lvg
              && n.lvg <= lvOf(get(/databases/$(database)/documents/players/$(request.auth.uid)).data.get('xp', 0)))
             ? n.lvg - o.lvg : 0;
    }
    function gBase(o, n) {
      return n.tix is int && n.tix >= 0 && n.tix <= 10
          && n.shards is int && n.shards >= 0 && n.shards <= 100000
          && n.own is list && n.own.size() <= 60
          && n.pulls is int && n.pulls >= o.pulls && n.pulls - o.pulls <= 10
          && n.hx is int && n.hx >= 0 && n.hx <= 20
          && n.gifts is list && n.gifts.size() <= 200
          && n.day is string && n.lvg is int && n.lvg >= o.lvg
          && n.get('evs', []) is list && n.get('evs', []).size() <= 50
          && n.get('tt', []) is list && n.get('tt', []).size() <= 60
          && n.get('sg', []) is list && n.get('sg', []).size() <= 200
          && gMisOk(o, n);
    }
    // ひいた回数ぶんだけ券が減り、ボーナス・カケラは1回ごとの上限まで
    // 招待ボーナス: 承認ずみのリンク申請の記録がある場合だけ(招待した人2枚・招待された人1枚)
    function gInvTix(id) {
      let q = get(/databases/$(database)/documents/requests/$(id)).data;
      return (q.get('via', '') == 'link' && q.get('status', '') == 'accepted')
        ? (q.get('to', '') == request.auth.uid ? 2 : (q.get('from', '') == request.auth.uid ? 1 : 0)) : 0;
    }
    function gPullOk(o, n, extraTix, extraShards) {
      return n.tix + (n.pulls - o.pulls) <= o.tix + gDayGain(o, n) + gLvGain(o, n) + extraTix + (gMisD(o, n) ? 1 : 0) + (gMisW(o, n) ? 2 : 0)
          && n.hx <= o.hx + (n.pulls - o.pulls)
          && n.shards <= o.shards + 150 * (n.pulls - o.pulls) + extraShards + (gMisD(o, n) ? 3 : 0) + (gMisW(o, n) ? 10 : 0);
    }

    // ハートの現在値(時間回復ぶんを含む)
    function heartEff(d, t) {
      let e = d.get('hp', 5) + math.floor((t - d.get('hpAt', 0)) / 1800000);
      return e > 5 ? 5 : e;
    }
    function xpOk() {
      return (request.resource.data.get('xp', 0) == resource.data.get('xp', 0)
              && request.resource.data.get('xpAt', 0) == resource.data.get('xpAt', 0))
          || (request.resource.data.xp > resource.data.get('xp', 0)
              && request.resource.data.xp - resource.data.get('xp', 0) <= 40
              && request.resource.data.xpAt >= resource.data.get('xpAt', 0) + 20000
              && request.resource.data.xpAt <= request.time.toMillis() + 60000);
    }
    // ハートは増やせない(時間で回復するぶんだけ)
    function hpOk() {
      return (request.resource.data.get('hp', -1) == resource.data.get('hp', -1)
              && request.resource.data.get('hpAt', 0) == resource.data.get('hpAt', 0))
          || (request.resource.data.hp is number
              && request.resource.data.hp >= 0 && request.resource.data.hp <= 5
              && request.resource.data.hpAt is number
              && request.resource.data.hpAt <= request.time.toMillis() + 60000
              && heartEff(request.resource.data, request.time.toMillis()) <= heartEff(resource.data, request.time.toMillis()));
    }

    // プロフィール: 誰でも読める(友達コード検索のため)。書けるのは本人だけ
    match /players/{uid} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.get('xp', 0) == 0
        && request.resource.data.get('hp', 5) <= 5;
      allow delete: if signedIn() && request.auth.uid == uid;
      allow update: if signedIn() && request.auth.uid == uid && xpOk() && hpOk();
    }
    // 友達リスト: 本人だけ
    match /data/users/{uid}/{doc=**} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }
    // 友達リクエスト: 当事者だけ
    match /requests/{id} {
      allow read: if signedIn() && (resource.data.to == request.auth.uid || resource.data.from == request.auth.uid);
      allow create: if signedIn() && request.resource.data.from == request.auth.uid;
      allow update: if signedIn() && resource.data.to == request.auth.uid;
      allow delete: if signedIn() && (resource.data.to == request.auth.uid || resource.data.from == request.auth.uid);
    }
    // オンライン表示: 読むのは誰でも、書くのは本人だけ
    match /presence/{uid} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid;
    }
    // 招待: 送る人は自分名義で作成、受け取る人だけ読めて消せる
    match /invites/{id} {
      allow create: if signedIn() && request.resource.data.by == request.auth.uid;
      allow read, delete: if signedIn() && resource.data.to == request.auth.uid;
    }
    // ゲームルーム
    match /games/{code} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.host == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.host == request.auth.uid;

      match /members/{uid} {
        allow read: if signedIn();
        allow write: if signedIn() && (request.auth.uid == uid || isHost(code));
      }
      match /drawings/{id} {
        allow read: if signedIn();
        allow create, update: if signedIn() && request.resource.data.uid == request.auth.uid;
        allow delete: if signedIn() && (resource.data.uid == request.auth.uid || isHost(code));
      }
      match /results/{id} {
        allow read: if signedIn();
        allow write: if signedIn() && isHost(code);
      }
    }
    // 今日の1題: 1日1回だけ投稿でき、あとから書き換えられない
    match /daily/{date}/entries/{uid} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == uid
        && date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.score is number
        && request.resource.data.score >= 0 && request.resource.data.score <= 30;
    }
    // ガチャ: 本人だけ。券は「毎日1枚・ランクアップ・運営プレゼント」でしか増やせない
    match /gacha/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.tix is int && request.resource.data.tix <= 1
        && request.resource.data.shards == 0 && request.resource.data.pulls == 0 && request.resource.data.hx == 0
        && request.resource.data.own.size() == 0 && request.resource.data.gifts.size() == 0
        && (request.resource.data.day == '' || request.resource.data.day == jstDate())
        && request.resource.data.get('inv', []).size() == 0
        && request.resource.data.get('evs', []).size() == 0
        && request.resource.data.get('tt', []).size() == 0
        && request.resource.data.get('sg', []).size() == 0
        && request.resource.data.get('mdd', 0) == 0 && request.resource.data.get('mwk', 0) == 0
        && request.resource.data.lvg == 1;
      allow update: if signedIn() && request.auth.uid == uid
        && gBase(resource.data, request.resource.data)
        && ((request.resource.data.gifts.size() == resource.data.gifts.size()
             && gEvSame(resource.data, request.resource.data) && gTtSame(resource.data, request.resource.data) && gSgSame(resource.data, request.resource.data)
             && gPullOk(resource.data, request.resource.data, 0, 0))
          || (request.resource.data.gifts.size() == resource.data.gifts.size() + 1
             && gEvSame(resource.data, request.resource.data) && gTtSame(resource.data, request.resource.data) && gSgSame(resource.data, request.resource.data)
             && request.resource.data.gifts.hasAll(resource.data.gifts)
             && !resource.data.gifts.hasAny([request.resource.data.gifts[request.resource.data.gifts.size() - 1]])
             && gPullOk(resource.data, request.resource.data,
                  get(/databases/$(database)/documents/gifts/$(request.resource.data.gifts[request.resource.data.gifts.size() - 1])).data.get('tix', 0),
                  get(/databases/$(database)/documents/gifts/$(request.resource.data.gifts[request.resource.data.gifts.size() - 1])).data.get('shards', 0)))
          || (request.resource.data.gifts.size() == resource.data.gifts.size()
             && gEvSame(resource.data, request.resource.data) && gTtSame(resource.data, request.resource.data) && gSgSame(resource.data, request.resource.data)
             && request.resource.data.inv.size() == resource.data.get('inv', []).size() + 1
             && request.resource.data.inv.size() <= 10
             && request.resource.data.inv.hasAll(resource.data.get('inv', []))
             && !resource.data.get('inv', []).hasAny([request.resource.data.inv[request.resource.data.inv.size() - 1]])
             && gPullOk(resource.data, request.resource.data, gInvTix(request.resource.data.inv[request.resource.data.inv.size() - 1]), 0))
          || (request.resource.data.gifts.size() == resource.data.gifts.size()
             && gTtSame(resource.data, request.resource.data) && gSgSame(resource.data, request.resource.data)
             && request.resource.data.get('evs', []).size() == resource.data.get('evs', []).size() + 1
             && request.resource.data.evs.hasAll(resource.data.get('evs', []))
             && !resource.data.get('evs', []).hasAny([request.resource.data.evs[request.resource.data.evs.size() - 1]])
             && gEvOk(request.resource.data.evs[request.resource.data.evs.size() - 1])
             && gPullOk(resource.data, request.resource.data,
                  get(/databases/$(database)/documents/events/$(request.resource.data.evs[request.resource.data.evs.size() - 1])).data.get('tix', 0),
                  get(/databases/$(database)/documents/events/$(request.resource.data.evs[request.resource.data.evs.size() - 1])).data.get('shards', 0)))
          || (request.resource.data.gifts.size() == resource.data.gifts.size()
             && gEvSame(resource.data, request.resource.data) && gSgSame(resource.data, request.resource.data)
             && request.resource.data.get('tt', []).size() == resource.data.get('tt', []).size() + 1
             && request.resource.data.tt.hasAll(resource.data.get('tt', []))
             && !resource.data.get('tt', []).hasAny([request.resource.data.tt[request.resource.data.tt.size() - 1]])
             && gPullOk(resource.data, request.resource.data,
                  tTix(request.resource.data.tt[request.resource.data.tt.size() - 1]),
                  tShard(request.resource.data.tt[request.resource.data.tt.size() - 1])))
          || (request.resource.data.gifts.size() == resource.data.gifts.size()
             && gEvSame(resource.data, request.resource.data) && gTtSame(resource.data, request.resource.data)
             && request.resource.data.get('sg', []).size() == resource.data.get('sg', []).size() + 1
             && request.resource.data.sg.hasAll(resource.data.get('sg', []))
             && !resource.data.get('sg', []).hasAny([request.resource.data.sg[request.resource.data.sg.size() - 1]])
             && gPullOk(resource.data, request.resource.data,
                  sTix(request.resource.data.sg[request.resource.data.sg.size() - 1]),
                  sShard(request.resource.data.sg[request.resource.data.sg.size() - 1]))));
    }
    // 運営からのプレゼント: 読むだけ(作るのは運営がコンソールから)
    match /gifts/{id} {
      allow read: if signedIn();
    }
    // イベント: 読むだけ(開催の鍵。作るのは運営がコンソールから)
    match /events/{id} {
      allow read: if signedIn();
    }
    match /reports/{id} {
      allow create: if signedIn()
        && request.resource.data.by == request.auth.uid
        && request.resource.data.target is string
        && request.resource.data.reason is string
        && request.resource.data.reason.size() < 100
        && (!('img' in request.resource.data) || (request.resource.data.img is string && request.resource.data.img.size() < 300000));
    }
    // 利用状況(匿名の件数のみ)。書くのは本人、読むのは admins/{uid} がある人だけ
    match /usage/{id} {
      allow create, update: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.d == jstDate()
        && id == request.resource.data.d + '_' + request.auth.uid
        && request.resource.data.keys().hasOnly(['d', 'uid', 'first', 's', 'p', 'ai', 'qAt', 'ts'])
        && request.resource.data.p is map && request.resource.data.p.size() < 12
        && request.resource.data.ai is map && request.resource.data.ai.size() < 12;
      allow read: if signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    match /admins/{id} {
      allow read: if signedIn() && request.auth.uid == id;
    }
    match /dailyImg/{id} {
      allow read: if signedIn();
      allow create: if signedIn()
        && id.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}_' + request.auth.uid + '$')
        && request.resource.data.img is string
        && request.resource.data.img.size() < 300000;
    }
  }
}
